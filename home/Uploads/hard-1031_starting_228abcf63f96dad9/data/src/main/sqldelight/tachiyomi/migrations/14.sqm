-- Delta sync: queue of local changes waiting to be uploaded.
CREATE TABLE IF NOT EXISTS sync_delta_queue(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    table_name TEXT NOT NULL CHECK (table_name IN ('mangas', 'chapters')),
    record_id INTEGER NOT NULL,
    status TEXT NOT NULL DEFAULT 'PENDING' CHECK (status IN ('PENDING', 'IN_FLIGHT', 'FAILED')),
    batch_id TEXT,
    attempt_count INTEGER NOT NULL DEFAULT 0,
    last_error TEXT,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now'))
);

CREATE UNIQUE INDEX IF NOT EXISTS sync_delta_queue_pending_unique ON sync_delta_queue(table_name, record_id) WHERE status = 'PENDING';
CREATE INDEX IF NOT EXISTS sync_delta_queue_status_index ON sync_delta_queue(status, _id);
CREATE INDEX IF NOT EXISTS sync_delta_queue_batch_index ON sync_delta_queue(batch_id) WHERE batch_id IS NOT NULL;
CREATE INDEX IF NOT EXISTS sync_delta_queue_record_index ON sync_delta_queue(table_name, record_id);

CREATE TABLE IF NOT EXISTS sync_state(
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- A database can be left with is_syncing = 1 by older restores; those rows would never be tracked again.
UPDATE mangas SET is_syncing = 0 WHERE is_syncing = 1;
UPDATE chapters SET is_syncing = 0 WHERE is_syncing = 1;

-- Triggers: besides bumping `version`, queue the dirty row in sync_delta_queue.
DROP TRIGGER IF EXISTS update_manga_version;
CREATE TRIGGER update_manga_version AFTER UPDATE ON mangas
WHEN new.is_syncing = 0 AND (
    new.url != old.url OR
    new.description IS NOT old.description OR
    new.favorite != old.favorite
)
BEGIN
    UPDATE mangas SET version = version + 1
    WHERE _id = new._id;

    INSERT OR IGNORE INTO sync_delta_queue(table_name, record_id)
    VALUES ('mangas', new._id);
END;

DROP TRIGGER IF EXISTS update_chapter_and_manga_version;
CREATE TRIGGER update_chapter_and_manga_version AFTER UPDATE ON chapters
WHEN new.is_syncing = 0 AND (
    new.read != old.read OR
    new.bookmark != old.bookmark OR
    new.last_page_read != old.last_page_read
)
BEGIN
    -- Update the chapter version
    UPDATE chapters SET version = version + 1
    WHERE _id = new._id;

    INSERT OR IGNORE INTO sync_delta_queue(table_name, record_id)
    VALUES ('chapters', new._id);

    -- Update the manga version
    UPDATE mangas SET version = version + 1
    WHERE _id = new.manga_id AND (SELECT is_syncing FROM mangas WHERE _id = new.manga_id) = 0;

    INSERT OR IGNORE INTO sync_delta_queue(table_name, record_id)
    SELECT 'mangas', new.manga_id
    WHERE (SELECT is_syncing FROM mangas WHERE _id = new.manga_id) = 0;
END;

DROP TRIGGER IF EXISTS insert_manga_category_update_version;
CREATE TRIGGER insert_manga_category_update_version AFTER INSERT ON mangas_categories
WHEN (SELECT is_syncing FROM mangas WHERE _id = new.manga_id) = 0
BEGIN
    UPDATE mangas
    SET version = version + 1
    WHERE _id = new.manga_id;

    INSERT OR IGNORE INTO sync_delta_queue(table_name, record_id)
    VALUES ('mangas', new.manga_id);
END;

DROP TRIGGER IF EXISTS delete_manga_category_update_version;
CREATE TRIGGER delete_manga_category_update_version AFTER DELETE ON mangas_categories
WHEN (SELECT is_syncing FROM mangas WHERE _id = old.manga_id) = 0
BEGIN
    UPDATE mangas
    SET version = version + 1
    WHERE _id = old.manga_id;

    INSERT OR IGNORE INTO sync_delta_queue(table_name, record_id)
    VALUES ('mangas', old.manga_id);
END;

-- Rows that were already flagged as modified by the old version-only triggers have never been
-- uploaded; queue exactly those rows (not the whole library) for the first incremental push.
INSERT OR IGNORE INTO sync_delta_queue(table_name, record_id)
SELECT 'mangas', _id FROM mangas WHERE version > 0;

INSERT OR IGNORE INTO sync_delta_queue(table_name, record_id)
SELECT 'chapters', _id FROM chapters WHERE version > 0;
